  <step>
    <name>sc_renagro_mag-personas</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>bdc2</connection>
    <sql>select
	distinct on
	(p.per_identificacion)
    p.per_identificacion as per_numero_cedula,
	case
		when p.per_persona_natural is true then 'NATURAL'
		when p.per_persona_natural is false then 'JURIDICA'
		else null
	end as per_tipo_persona,
	p.per_reg_fecha as per_fecha_actualizacion,
	b.bol_telefono_convencional as per_telefono_fijo,
	b.bol_telefono_celular as per_telefono_celular,
	b.bol_informante_telefono as per_telefono_celular_info,
	b.bol_direccion_email as per_correo_electronico,
	'RENAGRO' as per_fuente
from
	sc_renagro_mag.personas p
inner join sc_renagro_mag.boletas b
    on
	p.per_id = b.per_id
order by
	p.per_identificacion,
	p.per_reg_fecha desc nulls last,
	p.per_id desc
limit 5;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
