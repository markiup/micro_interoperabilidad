  <step>
    <name>infocampo - cultivos </name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>bdc2</connection>
    <sql>select
	h.per_identificacion as cul_numero_cedula,
	hicr.cul_nombre_cultivo as cul_nombre,
	hicr.cul_superficie_plantada as cul_superficie,
	hicr.cul_superficie_plantada_unidad as cul_unidad,
	hicr.cul_forma_cultivar as cul_asociacion,
	null as cul_forma,
	coalesce(hicr.cul_is_uso_fert_organico, false) as cul_ferti_orga,
	coalesce(hicr.cul_is_uso_fert_quimico, false) as cul_ferti_quim,
	coalesce(hicr.cul_is_control_plagas_organico, false) as cul_plag_orga,
	coalesce(hicr.cul_is_control_plagas_quimico, false) as cul_plag_quim,
	'OTRO' as cul_riego,
	false as cul_rie_acceso,
	'' as cul_rie_fuente_agua,
	'' as cul_rie_sistema,
	'INFOCAMPO' as cul_fuente
from
	sc_infocampo_agricola.hom_infocampo_cultivo_renagro hicr ,
	sc_infocampo.hom_infocampo_productor_renagro h
where
	hicr.per_identificacion = h.per_identificacion
limit 1000</sql>
