  <step>
    <name>sc_afc-ubicacion</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>bdc2</connection>
    <sql>SELECT DISTINCT ON (hau.per_identificacion, hau.id_inscripcion_afc)
    hau.per_identificacion::varchar(20) AS per_numero_cedula,
    hau.id_inscripcion_afc::int4 AS ubi_bol_id,
    hau.bol_provincia::varchar(100) AS ubi_provincia_registro,
    hau.bol_canton::varchar(100) AS ubi_canton_registro,
    hau.bol_parroquia::varchar(100) AS ubi_parroquia_registro,
    NULL::varchar(100) AS ubi_provincia_residencia,
    NULL::varchar(100) AS ubi_canton_residencia,
    NULL::varchar(100) AS ubi_parroquia_residencia,
    CASE 
        WHEN hau.bol_distancia_al_domicilio BETWEEN -99999999.99 AND 99999999.99 
        THEN hau.bol_distancia_al_domicilio::numeric(10,2)
    END AS ubi_distancia_domicilio,
    'AFC'::varchar(30) AS ubi_fuente
FROM sc_afc_productor_ubicacion.hom_afc_ubicacion_renagro hau
ORDER BY 
    hau.per_identificacion,
    hau.id_inscripcion_afc,
    hau.inpr_reg_fecha DESC NULLS LAST
LIMIT 5</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta>
