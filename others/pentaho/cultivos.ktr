      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>afc - cultivos</from>
      <to>Table output 2</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>infocampo - cultivos </from>
      <to>Table output 2 2</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>sc_renagro_mag - cultivos</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>bdc2</connection>
    <sql>select
	p.per_identificacion as cul_numero_cedula,
	coalesce(sc_renagro_mag.catalogo_descripcion(c.cul_nombre_cultivo), c.cul_otro_nombre_cultivo) as cul_nombre,
	c.cul_superficie_plantada as cul_superficie,
	c.cul_superficie_plantada_unidad as cul_unidad,
	coalesce(sc_renagro_mag.catalogo_descripcion(c.cul_cultivo_asociado), c.cul_cultivo_asociado) as cul_asociacion,
	coalesce(sc_renagro_mag.catalogo_descripcion(c.cul_forma_cultivar), c.cul_forma_cultivar) as cul_forma,
	c.cul_is_uso_fert_organico as cul_ferti_orga,
	c.cul_is_uso_fert_quimico as cul_ferti_quim,
	c.cul_is_control_plagas_organico as cul_plag_orga,
	c.cul_is_control_plagas_quimico as cul_plag_quim,
	coalesce(sc_renagro_mag.catalogo_descripcion(c.cul_metodo_de_riego),c.cul_metodo_de_riego) as cul_riego,
	b.bol_is_acc_riego as cul_rie_acceso,
	coalesce(sc_renagro_mag.catalogo_descripcion(b.bol_fuente_agua_riego), b.bol_fuente_agua_riego) as cul_rie_fuente_agua,
	coalesce(sc_renagro_mag.catalogo_descripcion(b.bol_sistema_agua_riego), b.bol_sistema_agua_riego) as cul_rie_sistema,
	'RENAGRO' as cul_fuente
from
	sc_renagro_mag.personas p
inner join sc_renagro_mag.boletas b on
	b.per_id = p.per_id
inner join sc_renagro_mag.terrenos t
        on
	t.bol_id = b.bol_id
	and (t.ter_eliminado is not true
		or t.ter_eliminado is null)
inner join sc_renagro_mag.cultivos c
        on
	c.ter_id = t.ter_id
	and (c.cul_eliminado is not true
		or c.cul_eliminado is null)
limit 1000
</sql>
