    <connection>bdc2</connection>
    <sql>select
	distinct on
	(rp.cedula_dat)rp.cedula_dat as per_numero_cedula,
	rp.tipo_persona_dat as per_tipo_persona,
	rp.fecha_carga_raw as per_fecha_actualizacion,
	vic.bol_telefono_convencional as per_telefono_fijo,
	vic.bol_telefono_celular as per_telefono_celular,
	null as per_telefono_celular_info,
	vic.bol_direccion_email as per_correo_electronico,	
	'INFOCAMPO' as per_fuente
from
	sc_infocampo.raw_productores rp,
	sc_infocampo.val_infocampo_contacto vic
where
	trim(rp.cedula_dat) = trim(vic.identificacion_limpia)
order by
	rp.cedula_dat,
	rp.fecha_carga_raw desc nulls last
limit 5</sql>
