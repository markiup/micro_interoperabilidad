    <connection>bdc2</connection>
    <sql>select
	h.per_identificacion as ext_numero_cedula,
	max(
		case
			when hier.bol_is_asistencia_tecnica is true then 'Asistencia técnica'
			else null
		end
	) as ext_servicio_recibido,
	null::varchar(150) as ext_institucion,
	min(hier.fecha_primera_visita)::timestamp as ext_fecha_inicio,
	max(
		coalesce(
			nullif(trim(hiar.nombre_asociacion_normalizado), ''),
			nullif(trim(hiar.bol_nombre_asociacion_coop), '')
		)
	) as ext_asociacion_nombre,
	'INFOCAMPO' as ext_fuente
from
	sc_infocampo.hom_infocampo_productor_renagro h
left join sc_infocampo_extension.hom_infocampo_extension_renagro hier
	on hier.per_identificacion = h.per_identificacion
left join sc_infocampo_asociacion.hom_infocampo_asociacion_renagro hiar
	on hiar.per_identificacion = h.per_identificacion
group by
	h.per_identificacion
limit 5</sql>
