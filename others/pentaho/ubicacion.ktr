  <step>
    <name>sc_infocampo-ubicacion</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>bdc2</connection>
    <sql>select
	distinct on
	(hipu.per_identificacion,
	hipu.id_predio_origen)
    hipu.per_identificacion::varchar(20) as per_numero_cedula,
	hipu.id_predio_origen::int4 as ubi_bol_id,
	hipu.bol_provincia::varchar(100) as ubi_provincia_registro,
	hipu.bol_canton::varchar(100) as ubi_canton_registro,
	hipu.bol_parroquia::varchar(100) as ubi_parroquia_registro,
	null::varchar(100) as ubi_provincia_residencia,
	null::varchar(100) as ubi_canton_residencia,
	null::varchar(100) as ubi_parroquia_residencia,
	null::numeric(10, 2) as ubi_distancia_domicilio,
	'INFOCAMPO'::varchar(30) as ubi_fuente
from
	sc_infocampo_predio.hom_infocampo_predio_ubicacion_renagro hipu
where
	(hipu.ter_eliminado is not true
		or hipu.ter_eliminado is null)
order by
	hipu.per_identificacion,
	hipu.id_predio_origen,
	hipu.ter_reg_fecha desc nulls last
limit 5</sql>
