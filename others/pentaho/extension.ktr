  <step>
    <name>sc_afc-extension</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>bdc2</connection>
    <sql>select
	hac.per_identificacion as ext_numero_cedula,
	max(
		coalesce(
			nullif(trim(has.extension_servicio), ''),
			case
				when has.extension_recibio is true then 'Asistencia técnica'
				else null
			end
		)
	) as ext_servicio_recibido,
	null::varchar(150) as ext_institucion,
	min(has.vepr_reg_fecha)::timestamp as ext_fecha_inicio,
	max(nullif(trim(haa.bol_nombre_asociacion_coop), '')) as ext_asociacion_nombre,
	'AFC' as ext_fuente
from
	sc_afc_productor_contacto.hom_afc_productor_contacto_renagro hac
left join sc_afc_productor_servicios.hom_afc_servicios_renagro has
	on has.per_identificacion = hac.per_identificacion
left join sc_afc_productor_asociacion.hom_afc_asociacion_renagro haa
	on haa.per_identificacion = hac.per_identificacion
where
	has.per_identificacion is not null
	or haa.per_identificacion is not null
group by
	hac.per_identificacion
limit 5</sql>
